# SEO: dominio pubblico di produzione (senza slash finale), usato da
# metadataBase, sitemap.xml, robots.txt e Open Graph. Impostalo su Vercel
# non appena hai un dominio reale, altrimenti si usa un placeholder.
NEXT_PUBLIC_SITE_URL=https://www.neuropdf.it

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe (Developers -> API keys / Developers -> Webhooks -> il tuo endpoint)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# Payment Links (Product catalog -> ... -> Payment links) e i Price ID dei
# rispettivi prodotti (Product catalog -> click prodotto -> copia Price ID).
# Valori test in .env.local, valori live nell'ambiente di produzione.
NEXT_PUBLIC_STRIPE_CHECKOUT_URL_PRO=https://buy.stripe.com/your_pro_link
NEXT_PUBLIC_STRIPE_CHECKOUT_URL_TEAM=https://buy.stripe.com/your_team_link
STRIPE_PRICE_ID_PRO=price_your_pro_price_id
STRIPE_PRICE_ID_TEAM=price_your_team_price_id

# NVIDIA NIM Configuration
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_NIM_PARSE_ENDPOINT=https://integrate.api.nvidia.com/v1/metrics/nemotron-parse
NVIDIA_NIM_LLM_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_NIM_EMBED_ENDPOINT=https://integrate.api.nvidia.com/v1/embeddings

# Code AI: key dedicata (separata da NVIDIA_API_KEY), stessa piattaforma NVIDIA NIM
NVIDIA_CODE_API_KEY=your_nvidia_api_key

# Image AI: key dedicata per l'endpoint genai (es. black-forest-labs/flux.1-dev)
NVIDIA_IMAGE_API_KEY=your_nvidia_api_key

# Translator AI: key dedicata
NVIDIA_TRANSLATOR_API_KEY=your_nvidia_api_key

# Sentry (Settings -> Projects -> il tuo progetto -> Client Keys (DSN)).
# Vuoto = error tracking disattivato (no-op), non serve in dev/build.
NEXT_PUBLIC_SENTRY_DSN=
